{% extends 'base.html.twig' %}

{% block title %}Login{% endblock %}

{% block body %}
    <h1>Login</h1>
    {% if error %}
        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    <form action="{{ path('app_login') }}" method="post" class="col-md-6">
        <label for="username" class="form-label">Username</label>
        <input type="text" id="username" name="_username" value="{{ last_username }}" class="form-control mb-3" required>

        <label for="password" class="form-label">Password</label>
        <input type="password" id="password" name="_password" class="form-control mb-3" required>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button type="submit" class="btn btn-primary">Login</button>
    </form>
{% endblock %}
